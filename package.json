{
	"name": "sharedway",
	"private": true,
	"packageManager": "bun@1.2.15",
	"scripts": {
		"dev": "bun --bun turbo dev --",
		"verify": "bun --bun turbo verify --",
		"lint": "bun --bun turbo lint --",
		"ds": "cd packages/ds && bun",
		"db": "cd packages/domains && bun --env-file=../../.env --env-file=../../.env.local db",
		"deps": "taze -I -r",
		"symlink": "symlink-dir ./public ./apps/app/public",
		"postinstall": "bun run symlink"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.0.0-beta.5",
		"@types/bun": "latest",
		"symlink-dir": "^6.0.5",
		"taze": "^19.1.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"turbo": "^2.5.3"
	}
}
