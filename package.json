{
	"name": "sharedway",
	"private": true,
	"packageManager": "bun@1.2.13",
	"scripts": {
		"dev": "bun --bun turbo dev --",
		"verify": "turbo verify --",
		"ds": "cd packages/ds && bun",
		"deps": "taze -I -r",
		"symlink": "symlink-dir ./public ./apps/app/public",
		"env": "dotenvx run -f .env.local -f .env --log-level=error --",
		"postinstall": "bun run symlink"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.0.0-beta.5",
		"@types/bun": "latest",
		"symlink-dir": "^6.0.5",
		"taze": "^19.1.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"turbo": "^2.5.3"
	}
}